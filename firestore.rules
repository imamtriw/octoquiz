rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /octoquiz/shared-state {
      allow read, write: if request.auth != null;
    }

    match /sessions/{sessionId}/{collectionName}/{studentId} {
      allow read, write: if request.auth != null
        && (collectionName == 'students' || collectionName == 'historyStudents');
    }
  }
}
